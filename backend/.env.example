# Database
DB_HOST=localhost
DB_PORT=5432
# App runtime connection: non-superuser, NOBYPASSRLS, owns nothing (so RLS policies actually apply to it)
DB_USERNAME=aurora_app
DB_PASSWORD=change-me
DB_DATABASE=aurora
DB_SYNCHRONIZE=false
DB_LOGGING=false
# Migration/admin connection: owns the schema, used only by src/database/run-migrations.ts
DB_MIGRATION_USERNAME=aurora
DB_MIGRATION_PASSWORD=aurora

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
JWT_SECRET=your-jwt-secret-change-in-production
JWT_REFRESH_SECRET=your-jwt-refresh-secret-change-in-production

# MFA encryption key (for encrypting TOTP secrets at rest)
MFA_ENCRYPTION_KEY=your-mfa-encryption-key-32-bytes

# Application
PORT=3001
FRONTEND_URL=http://localhost:5173

# S3-compatible object storage
S3_BUCKET=aurora-assets
S3_REGION=sa-east-1
S3_ACCESS_KEY_ID=your-access-key
S3_SECRET_ACCESS_KEY=your-secret-key
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_URL=https://assets.aurora.com.br

# Email provider
EMAIL_PROVIDER=console
EMAIL_FROM=noreply@aurora.com.br
